#!/usr/bin/env sh
set -eu

SYSTEMCTL=/run/current-system/sw/bin/systemctl
SERVICE=dae.service

usage() {
    printf 'Usage: %s {on|off|restart|stat|status|test}\n' "$0" >&2
}

case "${1:-}" in
    on)
        exec sudo "$SYSTEMCTL" start "$SERVICE"
        ;;
    off)
        exec sudo "$SYSTEMCTL" stop "$SERVICE"
        ;;
    restart)
        exec sudo "$SYSTEMCTL" restart "$SERVICE"
        ;;
    stat|status)
        exec "$SYSTEMCTL" status "$SERVICE"
        ;;
    test)
        start=$(date +%s)
        if curl --max-time 10 -o /dev/null -sS http://google.com; then
            end=$(date +%s)
            printf 'curl google.com returned within %ss\n' "$((end - start))"
        else
            code=$?
            if [ "$code" -eq 28 ]; then
                printf 'Timeout after 10s\n' >&2
            else
                printf 'curl failed, exit code = %s\n' "$code" >&2
            fi
            exit "$code"
        fi
        ;;
    *)
        usage
        exit 2
        ;;
esac
